@@ -0,0 +1,32 @@
+import React from 'react';
+import { MessageSquare, Pencil, Trash2, X } from 'lucide-react';
+import { changeAnnotationDraft, editAnnotation, type AnnotationDraft } from '@/browser-extensions/annotationComposer';
+
+export function ControlGuiComposerAnnotations({ drafts, open, onOpen }: {
+  drafts: readonly AnnotationDraft[]; open: boolean; onOpen: (value: boolean) => void;
+}) {
+  const count = drafts.reduce((n, d) => n + d.notes.length, 0);
+  const [notice, setNotice] = React.useState('');
+  if (!count) return null;
+  return <div className="controlgui-composer-annotations" data-testid="controlgui-composer-annotations">
+    <button type="button" className="controlgui-composer-chip" aria-expanded={open}
+      onClick={() => { setNotice(''); onOpen(!open); }}><MessageSquare size={14} /> {count} 条注释</button>
+    {open && <div className="controlgui-composer-popover" role="region" aria-label="网页注释列表">
+      <div className="controlgui-composer-popover-header"><strong>{count} 条注释</strong><button type="button" title="关闭列表" aria-label="关闭列表" onClick={() => onOpen(false)}><X size={14} /></button></div>
+      {drafts.flatMap(d => d.notes.map((note, index) =>
+        <div className="controlgui-composer-note" key={d.key + ':' + index}>
+          <div className="controlgui-composer-note-top">
+            <code title={note.element.path}>{note.element.tagName.toLowerCase()}</code>
+            <span className="controlgui-composer-note-page" title={d.url}>{d.url}</span>
+            <button type="button" aria-label="编辑注释" title="编辑注释" onClick={() => {
+              if (editAnnotation(d, index)) onOpen(false); else setNotice('请打开对应预览页面后编辑这条注释。');
+            }}><Pencil size={14} /></button>
+            <button type="button" aria-label="删除注释" title="删除注释"
+              onClick={() => changeAnnotationDraft(d, d.notes.filter((_, i) => i !== index))}><Trash2 size={14} /></button>
+          </div>
+          <div className="controlgui-composer-comment">{note.comment}</div>
+        </div>))}
+      {notice && <div role="status">{notice}</div>}
+    </div>}
+  </div>;
+}

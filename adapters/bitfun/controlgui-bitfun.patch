@@ -0,0 +1,61 @@
+import type { BrowserAnnotationContribution, BrowserAnnotationNote } from './contracts';
+
+export interface AnnotationDraft {
+  key: string; sessionId: string; url: string; notes: readonly BrowserAnnotationNote[];
+  contribution: BrowserAnnotationContribution;
+}
+let snapshot: readonly AnnotationDraft[] = [];
+const subscribers = new Set<() => void>();
+const editors = new Map<string, (index: number) => void>();
+const composers = new Map<string, { open: () => void; send: () => void }>();
+const sending = new Set<string>();
+export const subscribeAnnotationDrafts = (fn: () => void) => { subscribers.add(fn); return () => { subscribers.delete(fn); }; };
+export const getAnnotationDrafts = () => snapshot;
+export function publishAnnotationDraft(draft: AnnotationDraft) {
+  const old = snapshot.find(d => d.key === draft.key);
+  if (old && old.contribution === draft.contribution && JSON.stringify(old.notes) === JSON.stringify(draft.notes)) return;
+  if (!old && !draft.notes.length) return;
+  snapshot = [...snapshot.filter(d => d.key !== draft.key), ...(draft.notes.length ? [draft] : [])];
+  subscribers.forEach(fn => fn());
+}
+export function changeAnnotationDraft(draft: AnnotationDraft, notes: readonly BrowserAnnotationNote[]) {
+  draft.contribution.saveDraft(draft.key, notes);
+  publishAnnotationDraft({ ...draft, notes });
+}
+export function registerAnnotationEditor(key: string, edit: (index: number) => void) {
+  editors.set(key, edit);
+  return () => { if (editors.get(key) === edit) editors.delete(key); };
+}
+export function editAnnotation(draft: AnnotationDraft, index: number) {
+  const edit = editors.get(draft.key);
+  if (!edit) return false;
+  edit(index); return true;
+}
+export function registerAnnotationComposer(sessionId: string, composer: { open: () => void; send: () => void }) {
+  composers.set(sessionId, composer);
+  return () => { if (composers.get(sessionId) === composer) composers.delete(sessionId); };
+}
+export function requestAnnotationComposer(sessionId: string, action: 'open' | 'send') {
+  const composer = composers.get(sessionId);
+  if (!composer) return false;
+  composer[action](); return true;
+}
+export function claimAnnotationSubmission(sessionId: string, drafts: readonly AnnotationDraft[]) {
+  if (sending.has(sessionId)) return false;
+  if (drafts.some(d => !snapshot.some(x => x.key === d.key && JSON.stringify(x.notes) === JSON.stringify(d.notes)))) return false;
+  sending.add(sessionId); return true;
+}
+export function finishAnnotationSubmission(sessionId: string, drafts: readonly AnnotationDraft[], ok: boolean) {
+  if (ok) for (const d of drafts) {
+    const current = snapshot.find(x => x.key === d.key);
+    if (current && JSON.stringify(current.notes) === JSON.stringify(d.notes)) changeAnnotationDraft(current, []);
+  }
+  sending.delete(sessionId);
+}
+export function formatAnnotationDrafts(drafts: readonly AnnotationDraft[]) {
+  return drafts.filter(d => d.notes.length).map(d => d.contribution.formatPrompt(d.notes, d.url)).join('\n\n');
+}
+
+export function composeAnnotationMessage(text: string, drafts: readonly AnnotationDraft[]) {
+  return [text, formatAnnotationDrafts(drafts)].filter(Boolean).join('\n\n');
+}

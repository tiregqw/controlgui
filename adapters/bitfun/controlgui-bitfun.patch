+  const found = buttons().find(item => item.textContent === text);
+  if (!found) throw Error('Missing button: ' + text);
+  return found;
+}
+
+beforeEach(() => {
+  document.documentElement.replaceChildren(document.createElement('head'), document.createElement('body'));

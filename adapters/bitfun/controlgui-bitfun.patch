+﻿import { createServer } from 'vite';
+import { mkdir, writeFile } from 'node:fs/promises';
+import { resolve } from 'node:path';
+const server = await createServer({ server: { middlewareMode: true, hmr: false }, appType: 'custom' });
+try {
+  const { default: plugin } = await server.ssrLoadModule('/src/browser-extensions/plugins/controlgui/index.ts');
+  const { exportBrowserAnnotationPackage } = await server.ssrLoadModule('/src/browser-extensions/runtimePackage.ts');
+  const pack = exportBrowserAnnotationPackage(plugin);
+  const dir = resolve('../../browser-plugin-packages');
+  await mkdir(dir, { recursive: true });
+  const output = resolve(dir, `${pack.manifest.id}-${pack.manifest.version}.bitfun-plugin.json`);
+  const data = JSON.stringify(pack, null, 2);
+  await writeFile(output, data, 'utf8');
+  console.log(JSON.stringify({ output, bytes: Buffer.byteLength(data), format: pack.format }));
+} finally { await server.close(); }

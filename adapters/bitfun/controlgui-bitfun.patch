diff --git a/src/web-ui/src/flow_chat/components/ControlGuiComposerAnnotations.test.tsx b/src/web-ui/src/flow_chat/components/ControlGuiComposerAnnotations.test.tsx
new file mode 100644
index 000000000..bd22bc9ed
--- /dev/null
+++ b/src/web-ui/src/flow_chat/components/ControlGuiComposerAnnotations.test.tsx
@@ -0,0 +1,58 @@
+// @vitest-environment jsdom
+import React, { act, useState, useSyncExternalStore } from 'react';
+import { createRoot, type Root } from 'react-dom/client';
+import { beforeEach, afterEach, expect, it, vi } from 'vitest';
+import { ControlGuiComposerAnnotations } from './ControlGuiComposerAnnotations';
+import { publishAnnotationDraft, getAnnotationDrafts, subscribeAnnotationDrafts, changeAnnotationDraft,
+  registerAnnotationEditor, claimAnnotationSubmission, finishAnnotationSubmission, composeAnnotationMessage,
+  type AnnotationDraft } from '@/browser-extensions/annotationComposer';
+import { formatControlGuiPrompt } from '@/browser-extensions/annotationProtocolV1';
+
+const contribution = { saveDraft: vi.fn(), formatPrompt: formatControlGuiPrompt } as unknown as AnnotationDraft['contribution'];
+function draft(sessionId='session-a', key='page-a'): AnnotationDraft {
+  return { key, sessionId, url:'http://localhost/preview', contribution,
+    notes:['第一条注释','第二条注释'].map(comment=>({comment,element:{tagName:'input',path:'#minutes',textContent:'',outerHTML:'<input>',sourceUrl:'http://localhost/preview'}})) };
+}
+function clearAll() { for (const d of getAnnotationDrafts()) changeAnnotationDraft(d, []); }
+function Composer({ sessionId }: { sessionId: string }) {
+  const [open, setOpen] = useState(false);
+  const drafts = useSyncExternalStore(subscribeAnnotationDrafts, getAnnotationDrafts, getAnnotationDrafts);
+  return <ControlGuiComposerAnnotations drafts={drafts.filter(d=>d.sessionId===sessionId)} open={open} onOpen={setOpen} />;
+}
+let el: HTMLDivElement, root: Root;
+const click = async (selector: string) => { await act(async () => el.querySelector<HTMLButtonElement>(selector)!.click()); };
+beforeEach(()=>{(globalThis as any).IS_REACT_ACT_ENVIRONMENT=true; clearAll(); el=document.createElement('div'); document.body.append(el); root=createRoot(el);});
+afterEach(async()=>{await act(async()=>root.unmount()); el.remove(); clearAll(); vi.clearAllMocks();});
+it('shows a count in the composer, expands the input tag and edits/deletes notes without crossing sessions',async()=>{
+  await act(async()=>{root.render(<Composer sessionId="session-a"/>);publishAnnotationDraft(draft());publishAnnotationDraft(draft('session-b','page-b'));});
+  expect(el.textContent).toContain('2 条注释');
+  expect(el.textContent).not.toContain('第一条注释');
+  await click('.controlgui-composer-chip');
+  expect(el.querySelector('code')!.textContent).toBe('input');
+  expect(el.textContent).toContain('第一条注释');
+  const edit=vi.fn();const dispose=registerAnnotationEditor('page-a',edit);
+  await click('[aria-label="编辑注释"]');expect(edit).toHaveBeenCalledWith(0);dispose();
+  await click('.controlgui-composer-chip');await click('[aria-label="删除注释"]');
+  expect(el.textContent).toContain('1 条注释');
+  expect(getAnnotationDrafts().find(d=>d.sessionId==='session-b')!.notes).toHaveLength(2);
+  expect(contribution.saveDraft).toHaveBeenCalled();
+});
+it('combines typed text and structured annotations, preserves failure and prevents duplicate send',()=>{
+  const d=draft();publishAnnotationDraft(d);publishAnnotationDraft(draft('session-b','page-b'));
+  const message=composeAnnotationMessage('请把按钮移到右边',[d]);
+  expect(message).toContain('请把按钮移到右边');expect(message).toContain('第一条注释');expect(message).toContain('#minutes');
+  expect(claimAnnotationSubmission('session-a',[d])).toBe(true);
+  expect(claimAnnotationSubmission('session-a',[d])).toBe(false);
+  finishAnnotationSubmission('session-a',[d],false);
+  expect(getAnnotationDrafts().find(x=>x.key===d.key)!.notes).toHaveLength(2);
+  expect(claimAnnotationSubmission('session-a',[d])).toBe(true);
+  finishAnnotationSubmission('session-a',[d],true);
+  expect(getAnnotationDrafts().some(x=>x.key===d.key)).toBe(false);
+  expect(getAnnotationDrafts().some(x=>x.sessionId==='session-b')).toBe(true);
+});
+it('preserves a revised batch while the original is being delivered',()=>{
+  const d=draft();publishAnnotationDraft(d);expect(claimAnnotationSubmission(d.sessionId,[d])).toBe(true);
+  changeAnnotationDraft(d,[...d.notes,{...d.notes[0],comment:'发送中新增'}]);
+  finishAnnotationSubmission(d.sessionId,[d],true);
+  expect(getAnnotationDrafts().find(x=>x.key===d.key)!.notes).toHaveLength(3);
+});

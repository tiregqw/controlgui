+export const inactiveAnnotationContribution: BrowserAnnotationContribution = {
+  label: '', activeLabel: '', maxNotes: 0,
+  createInspectorScript: noopScript, pauseInspectorScript: 'void 0;', cancelInspectorScript: 'void 0;',
+  createEditorOpenScript: noopScript, createEditorCloseScript: noopScript, createEditorStatusScript: noopScript,
+  editorEvent: () => '', editorOpenedEvent: () => '', markerClickEvent: () => '',
+  createMarkerScript: noopScript, createCleanupScript: noopScript,
+  draftKey: () => '', readDraft: () => [], saveDraft: () => {}, makeNote: () => null,
+  assertPageMatches: () => {}, formatPrompt: () => '',
+};

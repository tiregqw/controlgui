+  expect(document.querySelector('[data-openbitfun-controlgui-editor]')).toBeNull();
+  expect(invoke).not.toHaveBeenCalledWith('plugin:event|emit', {
+    event: controlGuiEditorOpenedEvent(label), payload: expect.anything(),
+  });

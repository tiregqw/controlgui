+// @vitest-environment jsdom
+import { beforeEach, expect, it } from 'vitest';
+import { BROWSER_EXTENSION_STORAGE_PREFIX, browserExtensionRegistry, getBrowserAnnotationExtension } from '../../registry';
+
+beforeEach(() => window.localStorage.clear());
+
+it('discovers the ControlGUI manifest and registers its webview contributions', () => {
+  const plugin = browserExtensionRegistry.get('controlgui');
+  expect(plugin?.manifest).toMatchObject({
+    id: 'controlgui', name: 'ControlGUI 网页批注',
+    target: 'browser-webview', defaultEnabled: true,
+  });
+  expect(browserExtensionRegistry.list().filter(item => item.manifest.id === 'controlgui')).toHaveLength(1);
+  expect(getBrowserAnnotationExtension()!.annotation.label).toBe('批注');
+  expect(getBrowserAnnotationExtension()!.annotation.editorEvent('tab')).toBe('browser-controlgui-editor-tab');
+  expect(getBrowserAnnotationExtension()!.annotation.createCleanupScript()).toContain('__openbitfunControlGuiPins?.dispose?.()');
+});
+
+it('remembers activation state but never removes existing ControlGUI draft data', () => {
+  expect(browserExtensionRegistry.enabled('controlgui')).toBe(true);
+  const key = 'openbitfun:controlgui:draft:v1:retain';
+  window.localStorage.setItem(key, '[{"test":"keep"}]');
+  browserExtensionRegistry.setEnabled('controlgui', false);
+  expect(browserExtensionRegistry.enabled('controlgui')).toBe(false);

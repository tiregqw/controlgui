diff --git a/src/web-ui/src/browser-extensions/registry.ts b/src/web-ui/src/browser-extensions/registry.ts
new file mode 100644
index 000000000..7cca9c2cd
--- /dev/null
+++ b/src/web-ui/src/browser-extensions/registry.ts
@@ -0,0 +1,138 @@
+/**
+ * Browser UI extension point for the native Tauri WebView.
+ *
+ * This is deliberately NOT the OpenCode server Plugin Host: that process can
+ * register Agent tools/hooks but cannot mount React toolbar contributions or
+ * inject page overlays. Browser extensions are trusted, packaged first-party
+ * frontend modules discovered at build time by Vite.
+ */
+import type { BrowserExtension, BrowserAnnotationContribution } from './contracts';
+import { parseBrowserAnnotationPackage, materializeBrowserAnnotationPackage, exportBrowserAnnotationPackage, type BrowserAnnotationPackage } from './runtimePackage';
+export type { BrowserExtension, BrowserExtensionManifest, BrowserAnnotationContribution } from './contracts';
+export type { FloatingEditorEvent as BrowserAnnotationEditorEvent } from './contracts';
+
+export const BROWSER_EXTENSION_STORAGE_PREFIX = 'openbitfun:browser-extension:enabled:v1:';
+const BROWSER_EXTENSION_STATE_EVENT = 'openbitfun:browser-extension-state-change';
+
+const bundled = import.meta.glob<{ default: BrowserExtension }>('./plugins/*/index.ts', { eager: true });
+const bundledExtensions = new Map<string, BrowserExtension>();
+const extensions = new Map<string, BrowserExtension>();
+const PACKAGE_KEY = 'openbitfun:browser-extension:package:v1';
+const CATALOG_EVENT = 'openbitfun:browser-extension-catalog-change';
+let installedPackage: BrowserAnnotationPackage | undefined;
+let catalogRevision = 0;
+
+for (const [path, module] of Object.entries(bundled)) {
+  const extension = module.default;
+  if (!extension?.manifest || !/^[a-z][a-z0-9-]*$/.test(extension.manifest.id)
+    || extension.manifest.target !== 'browser-webview') {
+    throw new Error('Invalid browser extension: ' + path);
+  }
+  if (bundledExtensions.has(extension.manifest.id)) {
+    throw new Error('Duplicate browser extension: ' + extension.manifest.id);
+  }
+  bundledExtensions.set(extension.manifest.id, extension);
+}
+
+// One runtime annotation provider, with bundled fallback until explicitly removed.
+// The package is persisted as JSON, not a host JS module.
+function loadCatalog(): void {
+  extensions.clear();
+  installedPackage = undefined;
+  try {
+    const raw = localStorage.getItem(PACKAGE_KEY);
+    if (raw === 'removed') return;
+    if (raw) {
+      installedPackage = parseBrowserAnnotationPackage(raw);
+      const extension = materializeBrowserAnnotationPackage(installedPackage);
+      extensions.set(extension.manifest.id, extension);
+      return;
+    }
+  } catch { /* invalid or unavailable storage: use bundled fallback */ }
+  for (const [id, extension] of bundledExtensions) extensions.set(id, extension);
+}
+loadCatalog();
+function publishCatalog(): void {
+  loadCatalog();
+  catalogRevision++;
+  window.dispatchEvent(new Event(CATALOG_EVENT));
+}
+if (typeof window !== 'undefined') window.addEventListener('storage', event => {
+  if (event.key === PACKAGE_KEY) publishCatalog();
+});
+
+export const browserExtensionRegistry = {
+  list(): readonly BrowserExtension[] { return Array.from(extensions.values()); },
+  revision(): number { return catalogRevision; },
+  subscribeCatalog(listener: () => void): () => void {
+    window.addEventListener(CATALOG_EVENT, listener);
+    return () => window.removeEventListener(CATALOG_EVENT, listener);
+  },
+  source(id: string): 'local' | 'bundled' | undefined {
+    return extensions.has(id) ? installedPackage?.manifest.id === id ? 'local' : 'bundled' : undefined;
+  },
+  install(raw: string): void {
+    const pack = parseBrowserAnnotationPackage(raw);
+    localStorage.setItem(PACKAGE_KEY, JSON.stringify(pack));
+    publishCatalog();
+  },
+  remove(id: string): void {
+    if (!extensions.has(id)) return;
+    // Remove the active provider, including the bundled registration. Keep drafts.
+    localStorage.setItem(PACKAGE_KEY, 'removed');
+    publishCatalog();
+  },
+  restoreBundled(): void {
+    localStorage.removeItem(PACKAGE_KEY);
+    publishCatalog();
+  },
+  exportPackage(id: string): BrowserAnnotationPackage {
+    const extension = extensions.get(id);
+    if (!extension) throw new Error('Unknown browser extension: ' + id);
+    return installedPackage?.manifest.id === id ? installedPackage : exportBrowserAnnotationPackage(extension);
+  },
+  get(id: string): BrowserExtension | undefined { return extensions.get(id); },
+  enabled(id: string): boolean {
+    const extension = extensions.get(id);
+    if (!extension) return false;
+    try {
+      const value = localStorage.getItem(BROWSER_EXTENSION_STORAGE_PREFIX + id);
+      return value === null ? extension.manifest.defaultEnabled : value === 'true';
+    } catch { return extension.manifest.defaultEnabled; }
+  },
+  setEnabled(id: string, enabled: boolean): void {
+    if (!extensions.has(id)) throw new Error('Unknown browser extension: ' + id);
+    try { localStorage.setItem(BROWSER_EXTENSION_STORAGE_PREFIX + id, String(enabled)); }
+    catch { /* Browser storage may be unavailable. Host still applies state. */ }
+    if (typeof window !== 'undefined') {
+      window.dispatchEvent(new CustomEvent(BROWSER_EXTENSION_STATE_EVENT, { detail: { id, enabled } }));
+    }
+  },
+  subscribe(listener: (id: string, enabled: boolean) => void): () => void {
+    const onLocal = (event: Event) => {
+      const detail = (event as CustomEvent<{ id: string; enabled: boolean }>).detail;
+      if (detail && extensions.has(detail.id)) listener(detail.id, detail.enabled);
+    };
+    const onStorage = (event: StorageEvent) => {
+      if (!event.key?.startsWith(BROWSER_EXTENSION_STORAGE_PREFIX)) return;
+      const id = event.key.slice(BROWSER_EXTENSION_STORAGE_PREFIX.length);
+      if (extensions.has(id)) listener(id, browserExtensionRegistry.enabled(id));
+    };
+    window.addEventListener(BROWSER_EXTENSION_STATE_EVENT, onLocal);
+    window.addEventListener('storage', onStorage);
+    return () => {
+      window.removeEventListener(BROWSER_EXTENSION_STATE_EVENT, onLocal);
+      window.removeEventListener('storage', onStorage);
+    };
+  },
+};
+
+/**
+ * One annotation slot is currently supported. Missing providers are valid:
+ * the native browser and its ordinary context picker remain available.
+ */
+export function getBrowserAnnotationExtension(): (BrowserExtension & { annotation: BrowserAnnotationContribution }) | undefined {
+  return browserExtensionRegistry.list().find(
+    (extension): extension is BrowserExtension & { annotation: BrowserAnnotationContribution } => !!extension.annotation
+  );
+}

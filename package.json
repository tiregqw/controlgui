{
  "name": "@local/dsh-codex-gui",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-commands",
        "@deepseek-ai/dsh-api-workspace-controller"
      ],
      "external": []
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "install:web": "node install.mjs --profile web",
    "uninstall:web": "node install.mjs --profile web --uninstall"
  },
  "files": [
    "src",
    "lib",
    "assets",
    "package.json",
    "build.mjs",
    "install.mjs",
    "install-shared-package.mjs",
    "README.md",
    "cordis.patch.yml"
  ],
  "license": "MIT",
  "description": "Visual annotation and feedback for agent-generated and existing web interfaces",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tiregqw/controlgui.git"
  },
  "engines": {
    "node": ">=24"
  }
}
